{
  "name": "vera",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Vera backend gateway",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "setup": "node scripts/setup.mjs",
    "deploy:candidate": "node scripts/release.mjs candidate",
    "deploy:verify": "node scripts/release.mjs verify",
    "deploy:promote": "node scripts/release.mjs promote",
    "deploy:rollback": "node scripts/release.mjs rollback",
    "test": "node --test",
    "dev:web": "vite --config frontend/vite.config.js",
    "build:web": "vite build --config frontend/vite.config.js",
    "analyze:web": "npm run build:web && node scripts/analyze-web.mjs"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "dependencies": {
    "marked": "^18.0.7"
  }
}
